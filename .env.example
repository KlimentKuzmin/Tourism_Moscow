# ---- Telegram (обязательно для приёма заявок) --------------------------------
# Токен бота, выдаётся @BotFather при создании бота
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
# ID чата/группы, куда падают заявки. Для групп начинается с "-100".
# Узнать: добавьте бота в чат и откройте
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=-1001234567890
# Необязательно: ID темы (topic) в супергруппе с форумом
# TELEGRAM_THREAD_ID=12

# ---- Сайт --------------------------------------------------------------------
# Канонический адрес без слэша на конце. Используется в sitemap, JSON-LD, hreflang.
NEXT_PUBLIC_SITE_URL=https://tourism-moscow.example

# ---- Автопубликация блога ----------------------------------------------------
# Общий секрет для защиты /api/cron/publish. Сгенерировать: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-string

# ---- Аналитика (необязательно) -----------------------------------------------
# NEXT_PUBLIC_YANDEX_METRIKA_ID=00000000
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Необязательно: свой прокси для Telegram Bot API,
# если api.telegram.org недоступен из сети хостинга
# TELEGRAM_API_BASE=https://tg-proxy.example
