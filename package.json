{
  "name": "tourism-moscow",
  "version": "1.0.0",
  "private": true,
  "description": "Туристический сайт по Москве с SEO/AI-оптимизированным блогом, формами заявки и доставкой лидов в Telegram",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "blog:publish": "node scripts/publish-scheduled.mjs",
    "blog:new": "node scripts/generate-article.mjs",
    "check": "npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
